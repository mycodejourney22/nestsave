<%# Admin — Savings Plans Index %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900">Savings Plans</h1>
    <p class="text-sm text-gray-400 mt-0.5">All employee savings plans for <%= @current_company.name %></p>
  </div>
</div>

<%# Status filter tabs %>
<div class="border-b border-gray-200 mb-6">
  <nav class="flex gap-0 -mb-px">
    <% [["active", "Active"], ["pending", "Pending"], ["matured", "Matured"], ["closed", "Closed"]].each do |key, label| %>
      <% active = (params[:status].presence || "active") == key %>
      <%= link_to admin_savings_plans_path(@current_company.slug, status: key),
            class: "whitespace-nowrap px-4 py-3 text-sm font-medium border-b-2 transition-colors #{active ? "border-primary-500 text-primary-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"}" do %>
        <%= label %>
      <% end %>
    <% end %>
  </nav>
</div>

<% if @plans.empty? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm flex items-center justify-center py-16 text-center">
    <p class="text-sm text-gray-400">No <%= params[:status].presence || "active" %> savings plans.</p>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="bg-gray-50/70 border-b border-gray-100">
          <th class="text-left px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-gray-400">Employee</th>
          <th class="text-left px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-gray-400">Plan</th>
          <th class="text-right px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-gray-400">Monthly</th>
          <th class="text-right px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-gray-400">Saved</th>
          <th class="text-right px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-gray-400 hidden sm:table-cell">Target</th>
          <th class="text-left px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-gray-400 hidden md:table-cell">Starts</th>
          <th class="text-left px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-gray-400 hidden md:table-cell">Ends</th>
          <th class="text-left px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-gray-400">Status</th>
          <th class="text-right px-5 py-3.5"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @plans.each do |plan| %>
          <% membership = plan.company_membership %>
          <% profile = membership.employee_profile %>
          <% name = membership.display_name %>
          <% end_date = plan.start_date ? plan.start_date + plan.duration_months.months : nil %>
          <tr class="hover:bg-gray-50/60 transition-colors">
            <td class="px-5 py-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
                  <span class="text-primary-700 text-xs font-bold">
                    <%= name.split.first(2).map { |w| w[0] }.join.upcase %>
                  </span>
                </div>
                <%= link_to admin_employee_profile_path(@current_company.slug, profile, tab: "savings_advances"),
                      class: "text-sm font-semibold text-gray-900 hover:text-primary-600 transition-colors" do %>
                  <%= name %>
                <% end %>
              </div>
            </td>
            <td class="px-5 py-4 text-sm text-gray-700"><%= plan.name %></td>
            <td class="px-5 py-4 text-sm text-gray-700 text-right"><%= gbp(plan.monthly_amount) %></td>
            <td class="px-5 py-4 text-right">
              <span class="text-sm font-semibold text-gray-900"><%= gbp(plan.total_saved) %></span>
            </td>
            <td class="px-5 py-4 text-sm text-gray-500 text-right hidden sm:table-cell"><%= gbp(plan.target_amount) %></td>
            <td class="px-5 py-4 text-sm text-gray-600 hidden md:table-cell">
              <%= plan.start_date ? plan.start_date.strftime("%-d %b %Y") : "—" %>
            </td>
            <td class="px-5 py-4 text-sm text-gray-600 hidden md:table-cell">
              <%= end_date ? end_date.strftime("%-d %b %Y") : "—" %>
            </td>
            <td class="px-5 py-4"><%= status_badge(plan.status) %></td>
            <td class="px-5 py-4 text-right">
              <%= link_to "View profile",
                    admin_employee_profile_path(@current_company.slug, profile, tab: "savings_advances"),
                    class: "text-xs font-medium text-primary-600 hover:text-primary-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
