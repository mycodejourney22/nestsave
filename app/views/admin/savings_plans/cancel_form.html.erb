<%# Admin — Cancel Savings Plan (modal) %>

<turbo-frame id="modal">
  <div class="p-6">
    <div class="flex items-start justify-between mb-5">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Cancel Savings Plan</h2>
        <p class="text-sm text-gray-500 mt-0.5">
          <%= @plan.user.full_name %> &mdash; <%= @plan.name %>
        </p>
      </div>
      <button data-action="modal#close"
              class="text-gray-400 hover:text-gray-600 transition-colors p-1 -mr-1 rounded-lg hover:bg-gray-100">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <%# Savings summary %>
    <div class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 mb-5 space-y-1">
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Monthly deduction</span>
        <span class="font-medium text-gray-900"><%= gbp(@plan.monthly_amount) %></span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Months completed</span>
        <span class="font-medium text-gray-900">
          <%= @plan.duration_months - @plan.months_remaining %> of <%= @plan.duration_months %>
        </span>
      </div>
      <div class="flex justify-between text-sm border-t border-gray-200 pt-2 mt-2">
        <span class="text-gray-700 font-medium">Total saved (refund due)</span>
        <span class="font-bold text-gray-900"><%= gbp(@plan.total_saved) %></span>
      </div>
    </div>

    <div class="bg-amber-50 border border-amber-100 rounded-xl px-4 py-3 mb-5">
      <p class="text-sm text-amber-800">
        This will cancel the plan immediately. No further deductions will be made.
        You will need to manually process the refund of <strong><%= gbp(@plan.total_saved) %></strong> to the employee.
        The employee will be notified.
      </p>
    </div>

    <%= form_with url: cancel_admin_savings_plan_path(@current_company.slug, @plan),
          method: :patch do |f| %>
      <div class="mb-5">
        <%= label_tag :note, "Reason for cancellation", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= text_area_tag :note, nil,
              rows: 3,
              placeholder: "Explain why the plan is being cancelled...",
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 transition resize-none" %>
      </div>
      <div class="flex gap-3">
        <%= f.submit "Cancel plan",
              class: "flex-1 bg-amber-500 hover:bg-amber-600 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors cursor-pointer text-center" %>
        <button type="button" data-action="modal#close"
                class="px-4 py-2.5 rounded-xl text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors">
          Close
        </button>
      </div>
    <% end %>
  </div>
</turbo-frame>
